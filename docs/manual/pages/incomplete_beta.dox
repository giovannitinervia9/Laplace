 * - \ref laplace::math::own::log_ibetac_d1 "log_ibetac_d1()", \ref laplace::math::own::log_ibetac_d2 "log_ibetac_d2()", \ref laplace::math::own::log_ibetac_d3 "log_ibetac_d3()", \ref laplace::math::own::log_ibetac_d4 "log_ibetac_d4()", \ref laplace::math::own::log_ibetac_d5 "log_ibetac_d5()", \ref laplace::math::own::log_ibetac_d6 "log_ibetac_d6()"
 * - \ref laplace::math::own::beta_inv_result "beta_inv_result"
